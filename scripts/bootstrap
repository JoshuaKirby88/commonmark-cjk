#!/usr/bin/env bash

set -euo pipefail

project_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)
worktree_root="$project_root/.worktrees"

# shellcheck source=../upstreams.lock
source "$project_root/upstreams.lock"

require_command() {
  if ! command -v "$1" >/dev/null 2>&1; then
    echo "Required command is missing: $1" >&2
    exit 1
  fi
}

ensure_checkout() {
  local name=$1
  local url=$2
  local commit=$3
  local checkout="$worktree_root/$name"

  if [[ ! -d "$checkout/.git" ]]; then
    git clone --no-checkout --origin upstream "$url" "$checkout"
    git -C "$checkout" checkout --detach "$commit"
  fi

  local actual_url
  actual_url=$(git -C "$checkout" remote get-url upstream)
  if [[ "$actual_url" != "$url" ]]; then
    echo "$name has an unexpected upstream URL: $actual_url" >&2
    exit 1
  fi

  local actual_commit
  actual_commit=$(git -C "$checkout" rev-parse HEAD)
  if [[ "$actual_commit" != "$commit" ]]; then
    echo "$name is at $actual_commit, expected $commit" >&2
    echo "Refusing to move an existing checkout automatically." >&2
    exit 1
  fi
}

require_command git
require_command cmake
require_command npm
require_command python3
require_command sha256sum

mkdir -p "$worktree_root"

ensure_checkout commonmark-spec "$COMMONMARK_SPEC_URL" "$COMMONMARK_SPEC_COMMIT"
ensure_checkout cmark "$CMARK_URL" "$CMARK_COMMIT"
ensure_checkout commonmark.js "$COMMONMARK_JS_URL" "$COMMONMARK_JS_COMMIT"

lock_source="$project_root/locks/commonmark.js-package-lock.json"
actual_lock_hash=$(sha256sum "$lock_source" | cut -d ' ' -f 1)
if [[ "$actual_lock_hash" != "$COMMONMARK_JS_LOCK_SHA256" ]]; then
  echo "The commonmark.js dependency lock hash does not match upstreams.lock." >&2
  exit 1
fi

js_lock="$worktree_root/commonmark.js/package-lock.json"
if [[ -e "$js_lock" ]]; then
  echo "Refusing to overwrite an existing commonmark.js package-lock.json." >&2
  exit 1
fi

cleanup_js_lock() {
  rm -f "$js_lock"
}
trap cleanup_js_lock EXIT

cp "$lock_source" "$js_lock"
npm ci --ignore-scripts --no-audit --no-fund --prefix "$worktree_root/commonmark.js"
cleanup_js_lock
trap - EXIT

cmake -S "$worktree_root/cmark" -B "$worktree_root/cmark/build" \
  -DCMAKE_EXPORT_COMPILE_COMMANDS=ON \
  -DBUILD_SHARED_LIBS=YES
cmake --build "$worktree_root/cmark/build"

echo "Pinned upstream checkouts and build dependencies are ready."
