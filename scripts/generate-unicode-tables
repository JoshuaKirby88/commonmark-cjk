#!/usr/bin/env python3

import argparse
import hashlib
import json
from pathlib import Path
import sys


PROJECT_ROOT = Path(__file__).resolve().parent.parent
DATA_ROOT = PROJECT_ROOT / ".worktrees" / "unicode-17"
MAX_CODE_POINT = 0x10FFFF

SOURCES = {
    "DerivedGeneralCategory.txt": (
        "d62e5bab70ca74f099343f71224fa051cb1fdd61a1ab45c0488c44cfc0b6102e"
    ),
    "EastAsianWidth.txt": (
        "ea7ce50f3444a050333448dffef1cadd9325af55cbb764b4a2280faf52170a33"
    ),
    "Scripts.txt": (
        "9f5e50d3abaee7d6ce09480f325c706f485ae3240912527e651954d2d6b035bf"
    ),
    "emoji-data.txt": (
        "2cb2bb9455cda83e8481541ecf5b6dfda66a3bb89efa3fa7c5297eccf607b72b"
    ),
}


def fail(message):
    print(message, file=sys.stderr)
    raise SystemExit(1)


def source_path(name):
    path = DATA_ROOT / name
    if not path.is_file():
        fail(f"Missing {path}. Run scripts/bootstrap-candidate first.")
    actual = hashlib.sha256(path.read_bytes()).hexdigest()
    if actual != SOURCES[name]:
        fail(f"Hash mismatch for {path}: {actual}")
    return path


def property_records(path):
    for raw_line in path.read_text(encoding="utf-8").splitlines():
        line = raw_line.split("#", 1)[0].strip()
        if not line:
            continue
        code_points, value = (part.strip() for part in line.split(";", 1))
        if ".." in code_points:
            first, last = (int(part, 16) for part in code_points.split(".."))
        else:
            first = last = int(code_points, 16)
        yield first, last, value


def mark(flags, path, accepted_values, value=1):
    for first, last, property_value in property_records(path):
        if property_value in accepted_values:
            flags[first : last + 1] = bytes([value]) * (last - first + 1)


def cjk_ranges():
    assigned = bytearray(b"\x01") * (MAX_CODE_POINT + 1)
    wide = bytearray(MAX_CODE_POINT + 1)
    hangul = bytearray(MAX_CODE_POINT + 1)
    emoji_presentation = bytearray(MAX_CODE_POINT + 1)

    mark(
        assigned,
        source_path("DerivedGeneralCategory.txt"),
        {"Cn", "Cs"},
        value=0,
    )
    mark(wide, source_path("EastAsianWidth.txt"), {"W", "F", "H"})
    mark(hangul, source_path("Scripts.txt"), {"Hangul"})
    mark(
        emoji_presentation,
        source_path("emoji-data.txt"),
        {"Emoji_Presentation"},
    )

    ranges = []
    range_start = None
    for code_point in range(MAX_CODE_POINT + 2):
        is_cjk = code_point <= MAX_CODE_POINT and assigned[code_point] and (
            (wide[code_point] and not emoji_presentation[code_point])
            or hangul[code_point]
        )
        if is_cjk and range_start is None:
            range_start = code_point
        elif not is_cjk and range_start is not None:
            ranges.append((range_start, code_point - 1))
            range_start = None
    return ranges


def validate_ranges(ranges):
    expected = {
        0x8A9E: True,
        0x300C: True,
        0x1160: True,
        0x20BB7: True,
        0x1F600: False,
        0x201C: False,
        0xE0100: False,
        0x2FA20: False,
    }
    for test_code_point, expected_result in expected.items():
        actual_result = any(
            first <= test_code_point <= last for first, last in ranges
        )
        if actual_result != expected_result:
            fail(
                f"Unexpected classification for {code_point(test_code_point)}: "
                f"{actual_result}"
            )


def code_point(value):
    return f"U+{value:04X}"


def render_json(ranges):
    document = {
        "schema_version": 1,
        "unicode_version": "17.0.0",
        "definition": "assigned and (((EAW in W,F,H) and not Emoji_Presentation) or Script=Hangul)",
        "inputs": SOURCES,
        "range_count": len(ranges),
        "ranges": [
            {"first": code_point(first), "last": code_point(last)}
            for first, last in ranges
        ],
    }
    return json.dumps(document, ensure_ascii=False, indent=2) + "\n"


def render_c(ranges):
    lines = [
        "/* Generated by scripts/generate-unicode-tables.",
        " * Unicode 17.0.0. Do not edit by hand.",
        " */",
    ]
    lines.extend(
        f"{{0x{first:X}, 0x{last:X}}}," for first, last in ranges
    )
    return "\n".join(lines) + "\n"


def render_javascript(ranges):
    lines = [
        '"use strict";',
        "",
        "// Generated by scripts/generate-unicode-tables.",
        "// Unicode 17.0.0. Do not edit by hand.",
        "var cjkRanges = [",
    ]
    lines.extend(
        f"    [0x{first:X}, 0x{last:X}]," for first, last in ranges
    )
    lines.extend(
        [
            "];",
            "",
            "var isCjk = function(codePoint) {",
            "    var low = 0;",
            "    var high = cjkRanges.length - 1;",
            "    while (low <= high) {",
            "        var middle = Math.floor((low + high) / 2);",
            "        var range = cjkRanges[middle];",
            "        if (codePoint < range[0]) {",
            "            high = middle - 1;",
            "        } else if (codePoint > range[1]) {",
            "            low = middle + 1;",
            "        } else {",
            "            return true;",
            "        }",
            "    }",
            "    return false;",
            "};",
            "",
            "export default isCjk;",
            "",
        ]
    )
    return "\n".join(lines)


def update(path, content, check):
    if check:
        if not path.is_file() or path.read_text(encoding="utf-8") != content:
            fail(f"Generated file is stale: {path}")
        return
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")


parser = argparse.ArgumentParser()
parser.add_argument("--check", action="store_true")
args = parser.parse_args()

for candidate_name in ("cmark-candidate", "commonmark.js-candidate"):
    candidate_path = PROJECT_ROOT / ".worktrees" / candidate_name
    if not (candidate_path / ".git").is_dir():
        fail(f"Missing {candidate_path}. Run scripts/bootstrap-candidate first.")

ranges = cjk_ranges()
validate_ranges(ranges)
outputs = {
    PROJECT_ROOT / "generated" / "cjk-ranges.json": render_json(ranges),
    PROJECT_ROOT
    / ".worktrees"
    / "cmark-candidate"
    / "src"
    / "cjk_ranges.inc": render_c(ranges),
    PROJECT_ROOT
    / ".worktrees"
    / "commonmark.js-candidate"
    / "lib"
    / "cjk-ranges.js": render_javascript(ranges),
}

for output_path, output_content in outputs.items():
    update(output_path, output_content, args.check)

print(f"Unicode 17.0.0 CJK table verified: {len(ranges)} ranges.")
