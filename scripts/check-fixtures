#!/usr/bin/env python3

import argparse
import json
from pathlib import Path
import subprocess
import sys


PROJECT_ROOT = Path(__file__).resolve().parent.parent
FIXTURE_PATH = PROJECT_ROOT / "fixtures" / "emphasis.json"
GENERATED_PATH = PROJECT_ROOT / "fixtures" / "generated-boundaries.json"

parser = argparse.ArgumentParser()
parser.add_argument("--candidate", action="store_true")
args = parser.parse_args()

checkout_suffix = "-candidate" if args.candidate else ""
expected_field = "proposed_html" if args.candidate else "current_html"

PROGRAMS = {
    "cmark": [
        str(
            PROJECT_ROOT
            / ".worktrees"
            / f"cmark{checkout_suffix}"
            / "build"
            / "src"
            / "cmark"
        ),
        "--unsafe",
    ],
    "commonmark.js": [
        "node",
        str(
            PROJECT_ROOT
            / ".worktrees"
            / f"commonmark.js{checkout_suffix}"
            / "bin"
            / "commonmark"
        ),
    ],
}


def render(program, markdown):
    result = subprocess.run(
        program,
        input=markdown + "\n",
        text=True,
        capture_output=True,
        check=True,
    )
    return result.stdout


def fail(message):
    print(message, file=sys.stderr)
    raise SystemExit(1)


fixtures = json.loads(FIXTURE_PATH.read_text(encoding="utf-8"))
cases = fixtures.get("cases", [])
if fixtures.get("schema_version") != 1 or not cases:
    fail("fixtures/emphasis.json has an unsupported schema or no cases.")

seen = set()
for case in cases:
    case_id = case["id"]
    if case_id in seen:
        fail(f"Duplicate fixture id: {case_id}")
    seen.add(case_id)

    actual_change = case["current_html"] != case["proposed_html"]
    if case["change"] != actual_change:
        fail(f"Incorrect change flag: {case_id}")

    for name, program in PROGRAMS.items():
        actual = render(program, case["markdown"])
        if actual != case[expected_field]:
            fail(
                f"{name} output differs for {case_id}\n"
                f"expected: {case[expected_field]!r}\n"
                f"actual:   {actual!r}"
            )

generated = subprocess.run(
    [str(PROJECT_ROOT / "scripts" / "generate-cases")],
    text=True,
    capture_output=True,
    check=True,
).stdout
committed_generated = GENERATED_PATH.read_text(encoding="utf-8")
if generated != committed_generated:
    fail("fixtures/generated-boundaries.json is stale. Run scripts/generate-cases.")

changed = sum(case["change"] for case in cases)
mode = "candidate" if args.candidate else "baseline"
print(
    f"Fixture oracle verified against {mode}: {len(cases)} curated cases, "
    f"{changed} proposed changes, {len(cases) - changed} protected results."
)
