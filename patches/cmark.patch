+typedef struct {
+  int32_t first;
+  int32_t last;
+} cjk_range;
+
+static const cjk_range cjk_ranges[] = {
+#include "cjk_ranges.inc"
+};
+
+static bool S_is_cjk(int32_t code_point) {
+  size_t low = 0;
+  size_t high = sizeof(cjk_ranges) / sizeof(cjk_ranges[0]);
+
+  while (low < high) {
+    size_t middle = low + (high - low) / 2;
+    if (code_point < cjk_ranges[middle].first) {
+      high = middle;
+    } else if (code_point > cjk_ranges[middle].last) {
+      low = middle + 1;
+    } else {
+      return true;
+    }
+  }
+  return false;
+}
